{
  "chapter.6A00000000000001.chapter_subtitle": ["Ein sanfter roter Faden – kein Zwang und keine harten Rezept-Sperren."],
  "chapter.6A00000000000001.title": "Willkommen zuhause",
  "file.0000000000000001.title": "Hasencraft",
  "quest.6A00000000000002.quest_desc": ["Schaut euch gemeinsam um und nehmt euch Zeit.", "Hasencraft ist als gemütliche gemeinsame Welt gedacht."],
  "quest.6A00000000000002.title": "Erst einmal ankommen",
  "task.6A00000000000003.title": "Wir sind bereit",
  "quest.6A00000000000004.quest_desc": ["Freundet euch mit einem Tier an oder baut einem kleinen Begleiter ein schönes Zuhause.", "Pet Beds von Redomesticate sind euer Sicherheitsnetz; Doggy Talents besitzt ein eigenes Rückkehrsystem."],
  "quest.6A00000000000004.title": "Ein flauschiger Freund",
  "task.6A00000000000005.title": "Herz vergeben",
  "quest.6A00000000000006.quest_desc": ["Findet oder baut euren ersten Waystone.", "Reisen kostet in Hasencraft weder Erfahrung noch Haltbarkeit – und Haustiere dürfen mit."],
  "quest.6A00000000000006.title": "Der Weg nach Hause",
  "task.6A00000000000007.title": "Waystone aktiviert",
  "quest.6A00000000000008.quest_desc": ["Richtet eine gemütliche Basis mit Bett, Küche und etwas Lagerplatz ein.", "Farmer's Delight, Handcrafted und die vielen Baumods sind genau dafür da."],
  "quest.6A00000000000008.title": "Ein gemeinsames Nest",
  "task.6A00000000000009.title": "Zuhause eingerichtet",
  "quest.6A0000000000000A.quest_desc": ["Sucht euch ein erstes großes Ziel aus: Aether, Twilight Forest, Bumblezone oder einfach einen weit entfernten Horizont.", "Waystones machen den Rückweg entspannt."],
  "quest.6A0000000000000A.title": "Fernweh",
  "task.6A0000000000000B.title": "Expedition begonnen",
  "quest.6A0000000000000C.quest_desc": ["Startet mit Create und baut eine erste kleine Maschine.", "Später führen Immersive Engineering, Applied Energistics 2 und Mekanism weiter – ohne künstliche Gates."],
  "quest.6A0000000000000C.title": "Es dreht sich was",
  "task.6A0000000000000D.title": "Erste Maschine läuft",
  "quest.6A0000000000000E.quest_desc": ["Ars Nouveau ist der kompakte Magiezweig des Packs.", "Ein erstes Zauberbuch reicht, um loszulegen; Ars Creo verbindet Magie später mit Create."],
  "quest.6A0000000000000E.title": "Ein Hauch Magie",
  "task.6A0000000000000F.title": "Zauberei entdeckt",
  "quest.6A00000000000010.quest_desc": ["Wenn Kisten überquellen, ist es Zeit für Sophisticated Storage oder Applied Energistics 2.", "Baut so klein oder groß, wie es zu euch passt."],
  "quest.6A00000000000010.title": "Ordnung im Kaninchenbau",
  "task.6A00000000000011.title": "Lagerproblem gelöst",
  "quest.6A00000000000012.quest_desc": ["Vertieft den Technikzweig, auf den ihr gerade Lust habt.", "Die empfohlene weiche Reihenfolge lautet Create → Immersive Engineering → AE2 → Mekanism."],
  "quest.6A00000000000012.title": "Fabriken mit Herz",
  "task.6A00000000000013.title": "Technikziel erreicht"
}
