/build/
/dist/
/hosting/channels/

# Local agent instructions may contain private infrastructure details.
/AGENTS.md

/.idea/
/.vscode/
/.packwiz-cache/
/.packwiz-config.toml

# Local runtime data must never enter the modpack repository.
/saves/
/world/
/world_nether/
/world_the_end/
# A checkout may also be used as a local server root. Keep its world state
# outside Git for the same reason as the normal repository-root runtime data.
/server/world/
/backups/
/logs/
/crash-reports/
/screenshots/
/Distant_Horizons_server_data/
/Distant_Horizons_data/
/XaeroWaypoints/
/XaeroWorldMap/
/packwiz.json
/options.txt
/servers.dat
/usercache.json
/usernamecache.json
/whitelist.json
/ops.json
/banned-*.json
/eula.txt
/server.properties

# Local server access notes and credentials must never be committed.
/server/private/

# Server-owned state generated by community mods.
/config/luckperms/
/config/bluemap/*
!/config/bluemap/webserver.conf
# Discord Integration stores its bot token per world. Keep this explicit even
# though the complete world directory is already ignored above.
/world/serverconfig/discordintegration-server.toml
