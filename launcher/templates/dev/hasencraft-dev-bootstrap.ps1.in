param(
    [Parameter(Mandatory = $true)]
    [string]$JavaExecutable
)

$ErrorActionPreference = "Stop"

$packRoot = __PACK_ROOT__
$packwiz = __PACKWIZ_EXECUTABLE__
$packTomlUri = __PACK_TOML_URI__
$bootstrap = Join-Path $env:INST_MC_DIR "packwiz-installer-bootstrap.jar"

if (-not (Test-Path -LiteralPath $JavaExecutable -PathType Leaf)) {
    throw "Prism did not provide a usable Java runtime: $JavaExecutable"
}
if (-not (Test-Path -LiteralPath $packRoot -PathType Container)) {
    throw "The Hasencraft source directory is unavailable: $packRoot"
}
if (-not (Test-Path -LiteralPath $packwiz -PathType Leaf)) {
    throw "The configured packwiz executable is unavailable: $packwiz"
}
if (-not (Test-Path -LiteralPath $bootstrap -PathType Leaf)) {
    throw "Missing packwiz bootstrap: $bootstrap"
}

# Prism normally supplies javaw.exe. PowerShell does not wait for GUI-subsystem
# executables invoked with the call operator, so Minecraft could start while
# packwiz was still downloading mods. Prefer the matching console executable,
# which blocks until the bootstrap has completed.
$bootstrapJava = $JavaExecutable
if ([System.IO.Path]::GetFileName($bootstrapJava) -ieq "javaw.exe") {
    $consoleJava = Join-Path (Split-Path -Parent $bootstrapJava) "java.exe"
    if (Test-Path -LiteralPath $consoleJava -PathType Leaf) {
        $bootstrapJava = $consoleJava
    }
}

Write-Host "Preparing the local Hasencraft development pack..."
$refreshExitCode = 0
Push-Location -LiteralPath $packRoot
try {
    & $packwiz refresh
    $refreshExitCode = $LASTEXITCODE
}
finally {
    Pop-Location
}
if ($refreshExitCode -ne 0) {
    exit $refreshExitCode
}

& $bootstrapJava -jar $bootstrap $packTomlUri
if ($LASTEXITCODE -ne 0) {
    exit $LASTEXITCODE
}
